# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_in_production_min_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://lumabet:password@localhost:5432/lumabet_dev

# ── Stellar Network ───────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Deployed Contract IDs (set after deploying via Soroban CLI) ───────────────
LUMABET_CORE_CONTRACT_ID=
LUMABET_DICE_CONTRACT_ID=
LUMABET_RNG_CONTRACT_ID=

# ── Admin Key (NEVER commit the real value) ───────────────────────────────────
# Used by the resolver worker to sign resolve_bet transactions
ADMIN_SECRET_KEY=
